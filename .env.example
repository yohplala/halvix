# Halvix local configuration — copy this file to ".env" and fill in your values.
#
#   cp .env.example .env
#
# ".env" is gitignored, so your keys stay local and are never committed.
# Real environment variables (and GitHub Actions secrets) take precedence over
# this file, so CI is unaffected.

# Price-data provider: "coingecko" (default) or "cryptocompare".
PRICE_PROVIDER=coingecko

# CoinGecko Demo API key — free at https://www.coingecko.com/en/api
# Strongly recommended: the keyless tier is heavily rate-limited and can return
# truncated data, so daily updates may skip coins without a key.
COINGECKO_API_KEY=

# CryptoCompare / CoinDesk API key — only needed if PRICE_PROVIDER=cryptocompare
# Free key at https://developers.coindesk.com/
CRYPTOCOMPARE_API_KEY=
